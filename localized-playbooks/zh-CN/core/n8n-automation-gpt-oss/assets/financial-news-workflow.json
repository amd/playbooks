              {
                "id": "5412a5ee-dbbe-4fcc-98a5-6fafc37b94d1",
                "name": "All data",
                "type": "string",
                "value": "=新华网财经新闻标题：\n\n{{ [\n  ...($json.rollingHeadlines ?? []),\n  ...($json.mainHeadlines ?? []),\n  ...($json.dataHeadlines ?? []),\n  ...($json.insightHeadlines ?? [])\n]\n  .map(item => String(item).replace(/\\s+/g, ' ').trim())\n  .filter(Boolean)\n  .filter((item, index, arr) => arr.indexOf(item) === index)\n  .slice(0, 35)\n  .map((item, index) => `${index + 1}. ${item}`)\n  .join('\\n') }}"
              }
            ]
          },
          "options": {}
        },
