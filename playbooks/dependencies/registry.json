      },
      "validate": {
        "linux": {
          "cmd": "curl -sf --max-time 2 http://127.0.0.1:13305/api/v1/health",
          "expect_rc": 0
        },
        "windows": {
          "cmd": "curl.exe -sf --max-time 2 http://127.0.0.1:13305/api/v1/health",
          "expect_rc": 0
        }
      },
      "install": {
        "linux": {
          "script": "lemonade.install.sh",
          "timeout": 900
        },
        "windows": {
          "script": "lemonade.install.ps1",
          "timeout": 180
        }
      },
      "versionable": true
    },
