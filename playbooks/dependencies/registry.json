        }
      },
      "install": {
        "linux": {
          "cmd": "curl -fsSL https://lmstudio.ai/install.sh | bash && sudo ln -sf \"$HOME/.lmstudio/bin/lms\" /usr/local/bin/lms",
          "timeout": 900
        }
      },
      "versionable": true
    },
