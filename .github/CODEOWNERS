# CODEOWNERS is LAST-MATCH-WINS: for any file, the last matching line decides
# the reviewers. Order matters — broad rules first, more specific overrides after.

# New / changed playbooks.
/playbooks/ @adamlam2-amd @bconsolvo

# Website is intentionally unowned (no auto-requested reviewer).
/website/

# CI, workflows, scripts, and repo config. Any one of these can approve; the
# required-approval count is set in branch protection, not here.
/.github/ @harkgill-amd @sreeram-11 @lucbruni-amd

# auto-translations/ is generated automatically by translate-playbooks.yml.
# localized-playbooks/ holds human-uploaded translations (e.g. the China team).
# NOTE: test-playbooks.yml only triggers on 'playbooks/**', so changes under
# the translation trees never run playbook CI (translations are not tested).
/auto-translations/ @bconsolvo
/localized-playbooks/ @bconsolvo

# OrchestrAI CI integration. These come after /.github/ so they override it
# (last-match-wins) — OrchestrAI files are reviewed by @saman-amd only.
/.github/orchestrai-config.yml                             @saman-amd
/.github/scripts/orchestrai_matrix.py                      @saman-amd
/.github/scripts/orchestrai_trigger.py                     @saman-amd
/.github/scripts/orchestrai_verdict.py                     @saman-amd
/.github/scripts/orchestrai_report.py                      @saman-amd
/.github/workflows/test-playbooks-orchestrai.yml           @saman-amd
/.github/workflows/orchestrai-pr-command.yml               @saman-amd
/.github/workflows/test-localized-playbooks-orchestrai.yml @saman-amd
/.github/workflows/orchestrai-localized-pr-command.yml     @saman-amd

# Test scripts — placed last so they win over /.github/ for any test_*.py file.
test_*.py @sreeram-11 @harkgill-amd @adamlam2-amd
*test*.py @sreeram-11 @harkgill-amd @adamlam2-amd
